{
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1"
  },
  "permissions": {
    "ask": [
      "Edit(**/scripts/state-size-baseline.json)",
      "Edit(**/scripts/state-coupling-baseline.json)",
      "Edit(**/scripts/check-state-size.mjs)",
      "Edit(**/scripts/check-state-coupling.mjs)",
      "Edit(**/scripts/gate-changes.mjs)",
