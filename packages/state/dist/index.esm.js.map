{
  "name": "@wcstack/state",
  "version": "4.0.0-rc.9",
  "description": "Reactive state management with declarative data binding for Web Components. Zero dependencies, buildless.",
  "type": "module",
  "main": "./dist/index.esm.js",
  "module": "./dist/index.esm.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.esm.js"
    },
    "./auto": "./dist/auto.min.js",
    "./core": {
      "types": "./dist/split/core.d.ts",
      "import": "./dist/split/core.js"
    },
    "./features/*": {
      "types": "./dist/split/features/*.d.ts",
      "import": "./dist/split/features/*.js"
    },
    "./define": {
      "types": "./dist/define.d.ts",
      "import": "./dist/define.js"
    },
    "./manifest": {
      "types": "./dist/manifest.d.ts",
      "import": "./dist/manifest.esm.js"
    },
    "./parser": {
      "types": "./dist/parser.d.ts",
      "import": "./dist/parser.esm.js"
    },
    "./wcs-manifest.json": "./dist/wcs-manifest.json"
  },
  "files": [
    "dist",
    "!dist/core.min.js"
  ],
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "node build.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "golden": "node scripts/golden.mjs",
    "version:patch": "npm version patch",
    "version:minor": "npm version minor",
    "version:major": "npm version major",
    "prepublishOnly": "npm run build && npm run test:coverage"
  },
  "keywords": [
    "web-components",
    "state-management",
    "reactive",
    "data-binding",
    "proxy",
    "custom-elements",
    "shadow-dom",
    "buildless",
    "zero-dependencies",
    "declarative"
  ],
  "author": "mogera551",
  "homepage": "https://wcstack.github.io",
  "repository": {
    "type": "git",
    "url": "https://github.com/wcstack/wcstack.git",
    "directory": "packages/state"
  },
  "bugs": {
    "url": "https://github.com/wcstack/wcstack/issues"
  },
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@vitest/coverage-v8": "^4.1.11",
    "esbuild": "0.27.2",
    "eslint": "^9.39.5",
    "globals": "^16.5.0",
    "happy-dom": "^20.0.11",
    "rollup": "^4.63.5",
    "rollup-plugin-dts": "^6.5.1",
    "terser": "^5.51.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.1",
    "vitest": "^4.0.15"
  }
}
