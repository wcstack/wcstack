      "page": "<!DOCTYPE html><html><head></head><body>\n<wcs-state enable-ssr json='{\"v\":\"host-v\",\"w\":\"host-w\"}'></wcs-state>\n<p class=\"page\">{{ v }} / {{ w }}</p>\n<x-kid data-wcs=\"state.x: v; state.v: w\"><wcs-state bind-component=\"state\"></wcs-state><p class=\"kid\">{{ v }} / {{ x }}</p></x-kid>\n</body></html>",
