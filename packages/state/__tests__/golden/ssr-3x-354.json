    "basic": {
      "page": "<!DOCTYPE html><html><head></head><body>\n<wcs-state enable-ssr json='{\"title\":\"Hello\",\"count\":3,\"show\":true,\"items\":[{\"name\":\"Apple\",\"n\":1},{\"name\":\"Banana\",\"n\":2}]}'></wcs-state>\n<h1>{{ title }}</h1>\n<p class=\"count\" data-wcs=\"textContent: count\"></p>\n<ul>\n  <template data-wcs=\"for: items\">\n    <li><span data-wcs=\"textContent: .name\"></span> {{ .n }}</li>\n  </template>\n</ul>\n<template data-wcs=\"if: show\"><div class=\"shown\">shown {{ count }}</div></template>\n<template data-wcs=\"else:\"><div class=\"hidden\">hidden</div></template>\n<p class=\"comment\"><!--@@: title--></p>\n<input data-wcs=\"value: title\">\n</body></html>",
      "output": "\n<wcs-ssr version=\"3.5.4\"><script type=\"application/json\">{\"title\":\"Hello\",\"count\":3,\"show\":true,\"items\":[{\"name\":\"Apple\",\"n\":1},{\"name\":\"Banana\",\"n\":2}]}</script><template id=\"u0\" data-wcs=\"for: items\"><li><span data-wcs=\"textContent: items.*.name\"></span> <!--@@: items.*.n--></li></template><template id=\"u1\" data-wcs=\"if: show\"><div class=\"shown\">shown <!--@@: count--></div></template><template id=\"u2\" data-wcs=\"else:\"><div class=\"hidden\">hidden</div></template><script type=\"application/json\" data-wcs-ssr-props=\"\">{\"wcs-ssr-0\":{\"textContent\":\"3\"},\"wcs-ssr-1\":{\"textContent\":\"Apple\"},\"wcs-ssr-2\":{\"textContent\":\"Banana\"}}</script></wcs-ssr><wcs-state enable-ssr=\"\" json=\"{&quot;title&quot;:&quot;Hello&quot;,&quot;count&quot;:3,&quot;show&quot;:true,&quot;items&quot;:[{&quot;name&quot;:&quot;Apple&quot;,&quot;n&quot;:1},{&quot;name&quot;:&quot;Banana&quot;,&quot;n&quot;:2}]}\"></wcs-state>\n<h1><!--@@wcs-text-start:title-->Hello<!--@@wcs-text-end:title--></h1>\n<p class=\"count\" data-wcs=\"textContent: count\" data-wcs-ssr-id=\"wcs-ssr-0\">3</p>\n<ul>\n  <!--@@wcs-for:u0--><!--@@wcs-for-start:u0:items:0--><li><span data-wcs=\"textContent: items.*.name\" data-wcs-ssr-id=\"wcs-ssr-1\">Apple</span> <!--@@wcs-text-start:items.*.n-->1<!--@@wcs-text-end:items.*.n--></li><!--@@wcs-for-end:u0:items:0--><!--@@wcs-for-start:u0:items:1--><li><span data-wcs=\"textContent: items.*.name\" data-wcs-ssr-id=\"wcs-ssr-2\">Banana</span> <!--@@wcs-text-start:items.*.n-->2<!--@@wcs-text-end:items.*.n--></li><!--@@wcs-for-end:u0:items:1-->\n</ul>\n<!--@@wcs-if:u1--><!--@@wcs-if-start:u1:show--><div class=\"shown\">shown <!--@@wcs-text-start:count-->3<!--@@wcs-text-end:count--></div><!--@@wcs-if-end:u1:show-->\n<!--@@wcs-else:u2-->\n<p class=\"comment\"><!--@@wcs-text-start:title-->Hello<!--@@wcs-text-end:title--></p>\n<input data-wcs=\"value: title\" value=\"Hello\">\n"
    },
    "nested": {
      "page": "<!DOCTYPE html><html><head></head><body>\n<wcs-state enable-ssr json='{\"groups\":[{\"label\":\"A\",\"items\":[{\"v\":1},{\"v\":0}]},{\"label\":\"B\",\"items\":[{\"v\":3}]}]}'></wcs-state>\n<template data-wcs=\"for: groups\">\n  <section><h2>{{ .label }}</h2>\n    <template data-wcs=\"for: .items\"><p data-wcs=\"textContent: .v\"></p><template data-wcs=\"if: .v\"><i>{{ .v }}</i></template></template>\n  </section>\n</template>\n</body></html>",
      "output": "\n<wcs-ssr version=\"3.5.4\"><script type=\"application/json\">{\"groups\":[{\"label\":\"A\",\"items\":[{\"v\":1},{\"v\":0}]},{\"label\":\"B\",\"items\":[{\"v\":3}]}]}</script><template id=\"u5\" data-wcs=\"for: groups\"><section><h2><!--@@: groups.*.label--></h2>\n    <!--@@wcs-for:u6-->\n  </section></template><template id=\"u6\" data-wcs=\"for: groups.*.items\"><p data-wcs=\"textContent: groups.*.items.*.v\"></p><!--@@wcs-if:u7--></template><template id=\"u7\" data-wcs=\"if: groups.*.items.*.v\"><i><!--@@: groups.*.items.*.v--></i></template><script type=\"application/json\" data-wcs-ssr-props=\"\">{\"wcs-ssr-0\":{\"textContent\":\"1\"},\"wcs-ssr-1\":{\"textContent\":\"0\"},\"wcs-ssr-2\":{\"textContent\":\"3\"}}</script></wcs-ssr><wcs-state enable-ssr=\"\" json=\"{&quot;groups&quot;:[{&quot;label&quot;:&quot;A&quot;,&quot;items&quot;:[{&quot;v&quot;:1},{&quot;v&quot;:0}]},{&quot;label&quot;:&quot;B&quot;,&quot;items&quot;:[{&quot;v&quot;:3}]}]}\"></wcs-state>\n<!--@@wcs-for:u5--><!--@@wcs-for-start:u5:groups:0--><section><h2><!--@@wcs-text-start:groups.*.label-->A<!--@@wcs-text-end:groups.*.label--></h2>\n    <!--@@wcs-for:u6--><!--@@wcs-for-start:u6:groups.*.items:0--><p data-wcs=\"textContent: groups.*.items.*.v\" data-wcs-ssr-id=\"wcs-ssr-0\">1</p><!--@@wcs-if:u7--><!--@@wcs-if-start:u7:groups.*.items.*.v--><i><!--@@wcs-text-start:groups.*.items.*.v-->1<!--@@wcs-text-end:groups.*.items.*.v--></i><!--@@wcs-if-end:u7:groups.*.items.*.v--><!--@@wcs-for-end:u6:groups.*.items:0--><!--@@wcs-for-start:u6:groups.*.items:1--><p data-wcs=\"textContent: groups.*.items.*.v\" data-wcs-ssr-id=\"wcs-ssr-1\">0</p><!--@@wcs-if:u7--><!--@@wcs-for-end:u6:groups.*.items:1-->\n  </section><!--@@wcs-for-end:u5:groups:0--><!--@@wcs-for-start:u5:groups:1--><section><h2><!--@@wcs-text-start:groups.*.label-->B<!--@@wcs-text-end:groups.*.label--></h2>\n    <!--@@wcs-for:u6--><!--@@wcs-for-start:u6:groups.*.items:0--><p data-wcs=\"textContent: groups.*.items.*.v\" data-wcs-ssr-id=\"wcs-ssr-2\">3</p><!--@@wcs-if:u7--><!--@@wcs-if-start:u7:groups.*.items.*.v--><i><!--@@wcs-text-start:groups.*.items.*.v-->3<!--@@wcs-text-end:groups.*.items.*.v--></i><!--@@wcs-if-end:u7:groups.*.items.*.v--><!--@@wcs-for-end:u6:groups.*.items:0-->\n  </section><!--@@wcs-for-end:u5:groups:1-->\n"
    },
    "chain": {
      "page": "<!DOCTYPE html><html><head></head><body>\n<wcs-state enable-ssr json='{\"n\":2}'></wcs-state>\n<template data-wcs=\"if: n|eq(1)\"><b class=\"one\">one</b></template>\n<template data-wcs=\"elseif: n|eq(2)\"><b class=\"two\">two {{ n }}</b></template>\n<template data-wcs=\"elseif: n|eq(3)\"><b class=\"three\">three</b></template>\n<template data-wcs=\"else:\"><b class=\"other\">other</b></template>\n</body></html>",
      "output": "\n<wcs-ssr version=\"3.5.4\"><script type=\"application/json\">{\"n\":2}</script><template id=\"ud\" data-wcs=\"if: n|eq(1)\"><b class=\"one\">one</b></template><template id=\"uf\" data-wcs=\"else:\"><!--@@wcs-elseif:ue--><!--@@wcs-else:uh--></template><template id=\"ue\" data-wcs=\"elseif: n|eq(2)\"><b class=\"two\">two <!--@@: n--></b></template><template id=\"uh\" data-wcs=\"else:\"><!--@@wcs-elseif:ug--><!--@@wcs-else:ui--></template><template id=\"ug\" data-wcs=\"elseif: n|eq(3)\"><b class=\"three\">three</b></template><template id=\"ui\" data-wcs=\"else:\"><b class=\"other\">other</b></template></wcs-ssr><wcs-state enable-ssr=\"\" json=\"{&quot;n&quot;:2}\"></wcs-state>\n<!--@@wcs-if:ud-->\n<!--@@wcs-else:uf--><!--@@wcs-else-start:uf:n--><!--@@wcs-elseif:ue--><!--@@wcs-elseif-start:ue:n--><b class=\"two\">two <!--@@wcs-text-start:n-->2<!--@@wcs-text-end:n--></b><!--@@wcs-elseif-end:ue:n--><!--@@wcs-else:uh--><!--@@wcs-else-end:uf:n-->\n\n\n"
    },
    "connected": {
      "page": "<!DOCTYPE html><html><head></head><body>\n<wcs-state enable-ssr>\n  <script type=\"module\">\n    export default {\n      items: [],\n      $connectedCallback() { this.items = [\"server\"]; },\n    };\n  </script>\n</wcs-state>\n<ul><template data-wcs=\"for: items\"><li>{{ . }}</li></template></ul>\n</body></html>",
      "output": "\n<wcs-ssr version=\"3.5.4\"><script type=\"application/json\">{\"items\":[\"server\"]}</script><template id=\"uj\" data-wcs=\"for: items\"><li><!--@@: items.*--></li></template></wcs-ssr><wcs-state enable-ssr=\"\">\n  <script type=\"module\">\n    export default {\n      items: [],\n      $connectedCallback() { this.items = [\"server\"]; },\n    };\n  </script>\n</wcs-state>\n<ul><!--@@wcs-for:uj--><!--@@wcs-for-start:uj:items:0--><li><!--@@wcs-text-start:items.*-->server<!--@@wcs-text-end:items.*--></li><!--@@wcs-for-end:uj:items:0--></ul>\n"
    },
    "volume": {
      "page": "<!DOCTYPE html><html><head></head><body>\n<wcs-state enable-ssr json='{\"title\":\"T\",\"items\":[{\"n\":1},{\"n\":2}]}'></wcs-state>\n<wcs-state mount=\"cart\" json='{\"count\":2,\"lines\":[\"a\",\"b\"]}'></wcs-state>\n<p class=\"t\">{{ title }} / {{ cart.count }}</p>\n<ul><template data-wcs=\"for: cart.lines\"><li class=\"line\">{{ . }}</li></template></ul>\n<my-box><template data-wcs=\"for: items\"><b class=\"n\">{{ .n }}</b></template></my-box>\n</body></html>",
      "output": "\n<wcs-ssr version=\"3.5.4\"><script type=\"application/json\">{\"title\":\"T\",\"items\":[{\"n\":1},{\"n\":2}],\"cart\":{\"count\":2,\"lines\":[\"a\",\"b\"]}}</script><template id=\"ul\" data-wcs=\"for: cart.lines\"><li class=\"line\"><!--@@: cart.lines.*--></li></template><template id=\"um\" data-wcs=\"for: items\"><b class=\"n\"><!--@@: items.*.n--></b></template></wcs-ssr><wcs-state enable-ssr=\"\" json=\"{&quot;title&quot;:&quot;T&quot;,&quot;items&quot;:[{&quot;n&quot;:1},{&quot;n&quot;:2}]}\"></wcs-state>\n<wcs-state mount=\"cart\" json=\"{&quot;count&quot;:2,&quot;lines&quot;:[&quot;a&quot;,&quot;b&quot;]}\"></wcs-state>\n<p class=\"t\"><!--@@wcs-text-start:title-->T<!--@@wcs-text-end:title--> / <!--@@wcs-text-start:cart.count-->2<!--@@wcs-text-end:cart.count--></p>\n<ul><!--@@wcs-for:ul--><!--@@wcs-for-start:ul:cart.lines:0--><li class=\"line\"><!--@@wcs-text-start:cart.lines.*-->a<!--@@wcs-text-end:cart.lines.*--></li><!--@@wcs-for-end:ul:cart.lines:0--><!--@@wcs-for-start:ul:cart.lines:1--><li class=\"line\"><!--@@wcs-text-start:cart.lines.*-->b<!--@@wcs-text-end:cart.lines.*--></li><!--@@wcs-for-end:ul:cart.lines:1--></ul>\n<my-box><!--@@wcs-for:um--><!--@@wcs-for-start:um:items:0--><b class=\"n\"><!--@@wcs-text-start:items.*.n-->1<!--@@wcs-text-end:items.*.n--></b><!--@@wcs-for-end:um:items:0--><!--@@wcs-for-start:um:items:1--><b class=\"n\"><!--@@wcs-text-start:items.*.n-->2<!--@@wcs-text-end:items.*.n--></b><!--@@wcs-for-end:um:items:1--></my-box>\n"
    },
    "light": {
      "page": "<!DOCTYPE html><html><head></head><body>\n<wcs-state enable-ssr json='{\"title\":\"T\",\"user\":{\"name\":\"Ann\",\"age\":3,\"on\":true,\"tags\":[\"a\",\"b\"],\"profile\":{\"city\":\"X\"}},\"theme\":{\"mode\":\"dark\"}}'></wcs-state>\n<x-light data-wcs=\"state: user; state.theme: theme; state.where: user.profile; attr.title: title\"><wcs-state bind-component=\"state\"></wcs-state>\n  <p class=\"name\">{{ name }}</p><p class=\"age\">{{ age|add(1) }}</p><p class=\"mine\">{{ mine }}</p><p class=\"mode\">{{ theme.mode }}</p><p class=\"where\">{{ where.city }}</p>\n  <p class=\"bound\" data-wcs=\"textContent: name\"></p>\n  <ul><template data-wcs=\"for: tags\"><li>{{ . }}</li></template></ul>\n  <template data-wcs=\"if: on|not\"><i class=\"off\">off</i></template><template data-wcs=\"else:\"><i class=\"on\">{{ name }}</i></template>\n  <x-inner data-wcs=\"state: profile\"><wcs-state bind-component=\"state\"></wcs-state><em>{{ city }}</em></x-inner>\n  <y-deep data-wcs=\"state: profile\"><wcs-state bind-component=\"state\"></wcs-state><em class=\"deep\">{{ profile }}</em><em class=\"deep-city\">{{ city }}</em></y-deep>\n</x-light>\n<x-part data-wcs=\"state.label: user.name\"><wcs-state bind-component=\"state\"></wcs-state><p class=\"label\">{{ label }}</p><p class=\"other\">{{ other }}</p>\n  <x-inner data-wcs=\"state: box\"><wcs-state bind-component=\"state\"></wcs-state><em class=\"box\">{{ k }}</em></x-inner>\n  <y-own data-wcs=\"state: box\"><wcs-state bind-component=\"state\"></wcs-state><em class=\"own\">{{ box }}</em><em class=\"own-k\">{{ k }}</em></y-own>\n  <y-own-x data-wcs=\"state: box\"><wcs-state bind-component=\"state\"></wcs-state><em class=\"own-x\">{{ box.x }}</em></y-own-x>\n</x-part>\n</body></html>",
      "output": "\n<wcs-ssr version=\"3.5.4\"><script type=\"application/json\">{\"title\":\"T\",\"user\":{\"name\":\"Ann\",\"age\":3,\"on\":true,\"tags\":[\"a\",\"b\"],\"profile\":{\"city\":\"X\"}},\"theme\":{\"mode\":\"dark\"}}</script><template id=\"ur\" data-wcs=\"for: user.tags\"><li><!--@@: tags.*--></li></template><template id=\"us\" data-wcs=\"if: user.on|not\"><i class=\"off\">off</i></template><template id=\"ut\" data-wcs=\"else:\"><i class=\"on\"><!--@@: name--></i></template><script type=\"application/json\" data-wcs-ssr-props=\"\">{\"wcs-ssr-0\":{\"textContent\":\"Ann\"}}</script></wcs-ssr><wcs-state enable-ssr=\"\" json=\"{&quot;title&quot;:&quot;T&quot;,&quot;user&quot;:{&quot;name&quot;:&quot;Ann&quot;,&quot;age&quot;:3,&quot;on&quot;:true,&quot;tags&quot;:[&quot;a&quot;,&quot;b&quot;],&quot;profile&quot;:{&quot;city&quot;:&quot;X&quot;}},&quot;theme&quot;:{&quot;mode&quot;:&quot;dark&quot;}}\"></wcs-state>\n<x-light data-wcs=\"state: user; state.theme: theme; state.where: user.profile; attr.title: title\" title=\"T\"><wcs-state bind-component=\"state\"></wcs-state>\n  <p class=\"name\"><!--@@wcs-text-start:name-->Ann<!--@@wcs-text-end:name--></p><p class=\"age\"><!--@@wcs-text-start:age|add(1)-->4<!--@@wcs-text-end:age|add(1)--></p><p class=\"mine\"><!--@@wcs-text-start:mine-->own<!--@@wcs-text-end:mine--></p><p class=\"mode\"><!--@@wcs-text-start:theme.mode-->dark<!--@@wcs-text-end:theme.mode--></p><p class=\"where\"><!--@@wcs-text-start:where.city-->X<!--@@wcs-text-end:where.city--></p>\n  <p class=\"bound\" data-wcs=\"textContent: name\" data-wcs-ssr-id=\"wcs-ssr-0\">Ann</p>\n  <ul><!--@@wcs-for:ur--><!--@@wcs-for-start:ur:user.tags:0--><li><!--@@wcs-text-start:user.tags.*-->a<!--@@wcs-text-end:user.tags.*--></li><!--@@wcs-for-end:ur:user.tags:0--><!--@@wcs-for-start:ur:user.tags:1--><li><!--@@wcs-text-start:user.tags.*-->b<!--@@wcs-text-end:user.tags.*--></li><!--@@wcs-for-end:ur:user.tags:1--></ul>\n  <!--@@wcs-if:us--><!--@@wcs-else:ut--><!--@@wcs-else-start:ut:user.on--><i class=\"on\"><!--@@wcs-text-start:user.name-->Ann<!--@@wcs-text-end:user.name--></i><!--@@wcs-else-end:ut:user.on-->\n  <x-inner data-wcs=\"state: profile\"><wcs-state bind-component=\"state\"></wcs-state><em><!--@@wcs-text-start:city-->X<!--@@wcs-text-end:city--></em></x-inner>\n  <y-deep data-wcs=\"state: profile\"><wcs-state bind-component=\"state\"></wcs-state><em class=\"deep\"><!--@@wcs-text-start:profile-->deep-own<!--@@wcs-text-end:profile--></em><em class=\"deep-city\"><!--@@wcs-text-start:city-->X<!--@@wcs-text-end:city--></em></y-deep>\n</x-light>\n<x-part data-wcs=\"state.label: user.name\"><wcs-state bind-component=\"state\"></wcs-state><p class=\"label\"><!--@@wcs-text-start:label-->Ann<!--@@wcs-text-end:label--></p><p class=\"other\"><!--@@wcs-text-start:other-->o<!--@@wcs-text-end:other--></p>\n  <x-inner data-wcs=\"state: box\"><wcs-state bind-component=\"state\"></wcs-state><em class=\"box\"><!--@@wcs-text-start:k-->v<!--@@wcs-text-end:k--></em></x-inner>\n  <y-own data-wcs=\"state: box\"><wcs-state bind-component=\"state\"></wcs-state><em class=\"own\"><!--@@wcs-text-start:box-->mine<!--@@wcs-text-end:box--></em><em class=\"own-k\"><!--@@wcs-text-start:k-->v<!--@@wcs-text-end:k--></em></y-own>\n  <y-own-x data-wcs=\"state: box\"><wcs-state bind-component=\"state\"></wcs-state><em class=\"own-x\"><!--@@wcs-text-start:box.x-->own-x<!--@@wcs-text-end:box.x--></em></y-own-x>\n</x-part>\n"
