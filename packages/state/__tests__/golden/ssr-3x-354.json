    "exprs": {
      "page": "<!DOCTYPE html><html><head></head><body>\n<wcs-state enable-ssr json='{\"price\":3.14159,\"name\":\"Ann\",\"user\":{\"name\":\"Bo\",\"age\":3}}'></wcs-state>\n<p class=\"chain\">{{ price|mul(10)|round|unit(' pt') }}</p>\n<p class=\"str\"><!--@@: name|padStart(6,'*') --></p>\n<x-num data-wcs=\"state.p: price\"><wcs-state bind-component=\"state\"></wcs-state><p class=\"p\">{{ p|toFixed(2) }}</p></x-num>\n<x-light data-wcs=\"state: user\"><wcs-state bind-component=\"state\"></wcs-state><p class=\"age\">{{ age|add(1)|unit(' y') }}</p><p class=\"mine\">{{ mine|upper }}</p></x-light>\n</body></html>",
      "output": "\n<wcs-ssr version=\"3.5.4\"><script type=\"application/json\">{\"price\":3.14159,\"name\":\"Ann\",\"user\":{\"name\":\"Bo\",\"age\":3}}</script></wcs-ssr><wcs-state enable-ssr=\"\" json=\"{&quot;price&quot;:3.14159,&quot;name&quot;:&quot;Ann&quot;,&quot;user&quot;:{&quot;name&quot;:&quot;Bo&quot;,&quot;age&quot;:3}}\"></wcs-state>\n<p class=\"chain\"><!--@@wcs-text-start:price|mul(10)|round|unit(' pt')-->31 pt<!--@@wcs-text-end:price|mul(10)|round|unit(' pt')--></p>\n<p class=\"str\"><!--@@wcs-text-start:name|padStart(6,'*')-->***Ann<!--@@wcs-text-end:name|padStart(6,'*')--></p>\n<x-num data-wcs=\"state.p: price\"><wcs-state bind-component=\"state\"></wcs-state><p class=\"p\"><!--@@wcs-text-start:p|toFixed(2)-->3.14<!--@@wcs-text-end:p|toFixed(2)--></p></x-num>\n<x-light data-wcs=\"state: user\"><wcs-state bind-component=\"state\"></wcs-state><p class=\"age\"><!--@@wcs-text-start:age|add(1)|unit(' y')-->4 y<!--@@wcs-text-end:age|add(1)|unit(' y')--></p><p class=\"mine\"><!--@@wcs-text-start:mine|upper-->OWN<!--@@wcs-text-end:mine|upper--></p></x-light>\n"
