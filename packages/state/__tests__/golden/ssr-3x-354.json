    "filters": {
      "page": "<!DOCTYPE html><html><head></head><body>\n<wcs-state enable-ssr json='{\"price\":3.14159,\"items\":[1.5]}'></wcs-state>\n<p class=\"price\">{{ price|toFixed(2) }}</p>\n<ul><template data-wcs=\"for: items\"><li>{{ .|toFixed(2) }}</li></template></ul>\n</body></html>",
